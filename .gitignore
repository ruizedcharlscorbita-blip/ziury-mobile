# AI Stack v1.0 - Git Ignore Rules

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.pfx
secrets/
credentials/
config/local.*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDEs and Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.fleet/
.helix/
.zed/

# Package manager outputs
node_modules/
jspm_packages/
.pnpm-store/
.yarn/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build and Temp outputs
dist/
build/
out/
tmp/
temp/
*.log

# Python / Virtual Environments
.venv/
venv/
ENV/
env/
__pycache__/
*.pyc

# AI Context tool artifacts (Repomix, RTK, etc.)
repomix-output.txt
repomix.config.json
rtk-output.txt
code2prompt-output.txt
*context*.txt
.repomix/

# Local specific MCP settings or overrides
.mcp/local-config.json
.mcp/litellm.config.yaml
*.local.json
