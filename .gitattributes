# AI Stack v1.0 — Git Line Ending Rules
# Ensures all text files use LF on every OS (Unix-style).
# This prevents the "LF will be replaced by CRLF" warnings on Windows.

* text=auto eol=lf

# Explicitly enforce LF for all script and text file types
*.sh        text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.txt       text eol=lf
*.example   text eol=lf
*.env       text eol=lf

# Binary files — no line ending conversion
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.pdf       binary
