# ==============================================================================
# AI Stack v1.0 - Local Environment Configuration (Template)
# ==============================================================================
# Copy this file to '.env' and fill in your local API keys.
# DO NOT commit '.env' containing actual keys to git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Providers & API Keys
# ------------------------------------------------------------------------------
# OpenAI API Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# Anthropic API Settings
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Settings
GEMINI_API_KEY=your_gemini_api_key_here

# Cohere / Mistral / Groq / OpenRouter Settings
MISTRAL_API_KEY=your_mistral_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local LLM Models (Ollama, LM Studio)
OLLAMA_HOST=http://localhost:11434
LM_STUDIO_HOST=http://localhost:1234/v1

# ------------------------------------------------------------------------------
# MCP (Model Context Protocol) Options
# ------------------------------------------------------------------------------
# Toggle enabling/disabling MCP server features
MCP_DEBUG_MODE=false
MCP_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Context Optimization Settings
# ------------------------------------------------------------------------------
# Path where context packaging tools (e.g. repomix) will dump output files
CONTEXT_OUTPUT_PATH=./tmp/context-output.txt
