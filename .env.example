# ==============================================================================
# AI Stack v1.0 — Environment Configuration Template
# ==============================================================================
# HOW TO USE:
#   Run: bash ./scripts/bootstrap.sh
#   This copies .env.example → .env automatically.
#   Then open .env and fill in your real keys. Do NOT edit this file directly.
#   NEVER commit .env — it is listed in .gitignore.
# ==============================================================================

# ── TIER 1: BYOK — Direct API Keys (Default) ──────────────────────────────────
# Calls go directly from your tools to the provider's API. Zero setup required.
# Fill whichever provider(s) you use. Leave others blank.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# ── TIER 2: Provider Proxy Server (Optional — LiteLLM or similar) ─────────────
# When set, AI tools route ALL calls through a single local proxy endpoint
# instead of calling provider APIs directly. Tier 1 keys are still used by the
# proxy server itself. See docs/llm-setup.md for full setup instructions.

LLM_PROXY_BASE_URL=
LLM_PROXY_API_KEY=

# ── TIER 3: Local / Offline Models ────────────────────────────────────────────
# For fully private or air-gapped LLM usage. No API keys required.

OLLAMA_HOST=http://localhost:11434
LM_STUDIO_HOST=http://localhost:1234/v1

# ── MCP Settings ──────────────────────────────────────────────────────────────

MCP_DEBUG_MODE=false
MCP_LOG_LEVEL=info

# ── Context Optimization ──────────────────────────────────────────────────────

CONTEXT_OUTPUT_PATH=./tmp/context-output.txt
